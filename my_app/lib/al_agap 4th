class ReportScreen extends StatefulWidget {
  const ReportScreen({super.key});
  @override State<ReportScreen> createState() => _ReportScreenState();
}

class _ReportScreenState extends State<ReportScreen> {
  LatLng?         _userLocation;
  bool            _locating = true;
  String          _locationError = '';
  NearbyOrg?      _selectedOrg;
  List<NearbyOrg> _orgs = [];
  // MapController created lazily inside the widget tree
  MapController?  _mapController;

  @override void initState() { super.initState(); _getLocation(); }

  Future<void> _getLocation() async {
    try {
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        setState(() { _locating = false; _locationError = 'Location services are disabled. Please enable GPS.'; }); return;
      }
      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
        if (permission == LocationPermission.denied) {
          setState(() { _locating = false; _locationError = 'Location permission denied.'; }); return;
        }
      }
      if (permission == LocationPermission.deniedForever) {
        setState(() { _locating = false; _locationError = 'Location permission permanently denied. Enable it in Settings.'; }); return;
      }
      final pos = await Geolocator.getCurrentPosition(desiredAccuracy: LocationAccuracy.high);
      final u   = LatLng(pos.latitude, pos.longitude);
      setState(() {
        _userLocation = u;
        _locating     = false;
        _orgs = [
          NearbyOrg(name:'PAWS Animal Welfare',      type:'Animal Shelter',      emoji:'🏠', color:const Color(0xFFD6EAD8), position:LatLng(pos.latitude+0.007,pos.longitude+0.005), email:'paws@example.org',      phone:'+639171234567', distanceKm:0.8),
          NearbyOrg(name:'City Veterinary Office',   type:'Veterinary Office',   emoji:'🩺', color:const Color(0xFFCCE5F5), position:LatLng(pos.latitude-0.009,pos.longitude+0.008), email:'cityvet@example.gov',   phone:'+639179876543', distanceKm:1.2),
          NearbyOrg(name:'CARA Welfare Philippines', type:'Animal Organization', emoji:'🐾', color:const Color(0xFFEDD9F0), position:LatLng(pos.latitude+0.015,pos.longitude-0.010), email:'cara@example.org',       phone:'+639181234567', distanceKm:2.1),
          NearbyOrg(name:'Happy Paws Clinic',        type:'Veterinary Clinic',   emoji:'💊', color:const Color(0xFFFFE8D6), position:LatLng(pos.latitude-0.016,pos.longitude-0.012), email:'happypaws@example.com', phone:'+639191234567', distanceKm:2.4),
          NearbyOrg(name:'ASAP Animal Sanctuary',    type:'Adoption Center',     emoji:'🌿', color:const Color(0xFFD6EAD8), position:LatLng(pos.latitude+0.022,pos.longitude+0.018), email:'asap@example.org',      phone:'+639201234567', distanceKm:3.0),
        ];
      });
    } catch (e) {
      setState(() { _locating = false; _locationError = 'Could not get location: $e'; });
    }
  }

  Future<void> _sendEmail(NearbyOrg org) async {
    final subject = Uri.encodeComponent('Animal Report - AL-AGAP');
    final body    = Uri.encodeComponent('Hello,\n\nI would like to report a stray animal near my location '
        '(${_userLocation?.latitude.toStringAsFixed(5)}, ${_userLocation?.longitude.toStringAsFixed(5)}).\n\n'
        'Please find the attached photo.\n\nThank you,\nAL-AGAP User');
    final uri = Uri.parse('mailto:${org.email}?subject=$subject&body=$body');
    if (await canLaunchUrl(uri)) { await launchUrl(uri); } else { _showSnack('Could not open email app.'); }
  }

  Future<void> _sendSMS(NearbyOrg org) async {
    final body = Uri.encodeComponent('Hi! I found a stray animal near '
        'lat:${_userLocation?.latitude.toStringAsFixed(5)}, lng:${_userLocation?.longitude.toStringAsFixed(5)}. Sending via AL-AGAP. Can you help?');
    final uri = Uri.parse('sms:${org.phone}?body=$body');
    if (await canLaunchUrl(uri)) { await launchUrl(uri); } else { _showSnack('SMS is not supported on web. Use Email instead.'); }
  }

  void _showSnack(String msg) =>
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(msg)));

  void _showOrgSheet(NearbyOrg org) {
    setState(() => _selectedOrg = org);
    showModalBottomSheet(context: context, backgroundColor: Colors.transparent,
      builder: (_) => _OrgBottomSheet(org: org,
        onEmail: () { Navigator.pop(context); _sendEmail(org); },
        onSMS:   () { Navigator.pop(context); _sendSMS(org); }));
  }

