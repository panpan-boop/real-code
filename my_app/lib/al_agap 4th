                        : FlutterMap(
                            options: MapOptions(initialCenter: _userLocation!, initialZoom: 14.0,
                              onMapReady: () { /* map is ready */ }),
                            children: [
                              TileLayer(urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                                  userAgentPackageName: 'com.alagap.app'),
