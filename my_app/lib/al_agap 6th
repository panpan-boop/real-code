// ─────────────────────────────────────────────────────────────────────────────
// USER MODEL + STORE
// ─────────────────────────────────────────────────────────────────────────────
class AppUser {
  String     username;
  String     email;
  String?    bio;
  int        reportsCount;
  int        adoptionsCount;
  int        coins;
  String?    lastLoginDate;
  String?    avatarEmoji;
  Uint8List? avatarBytes;

  AppUser({
    required this.username,
    required this.email,
    this.bio,
    this.reportsCount   = 0,
    this.adoptionsCount = 0,
    this.coins          = 0,
    this.lastLoginDate,
    this.avatarEmoji,
    this.avatarBytes,
  });
}

AppUser? currentUser;

class AppUserStore {
  static const _kUsername    = 'username';
  static const _kEmail       = 'email';
  static const _kBio         = 'bio';
  static const _kReports     = 'reports';
  static const _kAdoptions   = 'adoptions';
  static const _kCoins       = 'coins';
  static const _kLastLogin   = 'lastLogin';
  static const _kAvatarEmoji = 'avatarEmoji';
  static const _kAvatarBytes = 'avatarBytes';

  static Future<void> load() async {
    final prefs = await SharedPreferences.getInstance();
    final username = prefs.getString(_kUsername);
    if (username != null) {
      Uint8List? avatarBytes;
      final b64 = prefs.getString(_kAvatarBytes);
      if (b64 != null) avatarBytes = base64Decode(b64);
      currentUser = AppUser(
        username:       username,
        email:          prefs.getString(_kEmail) ?? '',
        bio:            prefs.getString(_kBio),
        reportsCount:   prefs.getInt(_kReports)   ?? 0,
        adoptionsCount: prefs.getInt(_kAdoptions) ?? 0,
        coins:          prefs.getInt(_kCoins)     ?? 0,
        lastLoginDate:  prefs.getString(_kLastLogin),
        avatarEmoji:    prefs.getString(_kAvatarEmoji),
        avatarBytes:    avatarBytes,
      );
    }
  }

  static Future<void> save() async {
    if (currentUser == null) return;
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kUsername, currentUser!.username);
    await prefs.setString(_kEmail,    currentUser!.email);
    if (currentUser!.bio != null)
      await prefs.setString(_kBio, currentUser!.bio!);
    else
      await prefs.remove(_kBio);
    await prefs.setInt(_kReports,   currentUser!.reportsCount);
    await prefs.setInt(_kAdoptions, currentUser!.adoptionsCount);
    await prefs.setInt(_kCoins,     currentUser!.coins);
    if (currentUser!.lastLoginDate != null)
      await prefs.setString(_kLastLogin, currentUser!.lastLoginDate!);
    if (currentUser!.avatarEmoji != null)
      await prefs.setString(_kAvatarEmoji, currentUser!.avatarEmoji!);
    else
      await prefs.remove(_kAvatarEmoji);
    if (currentUser!.avatarBytes != null)
      await prefs.setString(_kAvatarBytes, base64Encode(currentUser!.avatarBytes!));
    else
      await prefs.remove(_kAvatarBytes);
  }

  static Future<void> clear() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.clear();
  }

  static Future<bool> checkDailyBonus() async {
    if (currentUser == null) return false;
    final today = DateTime.now().toIso8601String().substring(0, 10);
    if (currentUser!.lastLoginDate != today) {
      currentUser!.coins++;
      currentUser!.lastLoginDate = today;
      await save();
      return true;
    }
    return false;
  }
}

