    return Padding(padding: const EdgeInsets.fromLTRB(24, 20, 24, 8),
      child: Row(children: [
        Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text('AL-AGAP', style: TextStyle(fontSize: 26,
              fontWeight: FontWeight.bold, color: AppColors.softBrown,
              letterSpacing: 3)),
