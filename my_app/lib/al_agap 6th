// REPORT SCREEN
// FIX 1: Use CARTO tiles (OSM-based, free, no API key, policy-compliant)
// FIX 2: Org list uses Flexible so it never overflows in any orientation
// ─────────────────────────────────────────────────────────────────────────────
class ReportScreen extends StatefulWidget {
  const ReportScreen({super.key});
  @override State<ReportScreen> createState() => _ReportScreenState();
}

class _ReportScreenState extends State<ReportScreen> {
  LatLng?         _userLocation;
  bool            _locating = true;
  String          _locationError = '';
  NearbyOrg?      _selectedOrg;
  List<NearbyOrg> _orgs = [];

  @override void initState() { super.initState(); _getLocation(); }

  Future<void> _getLocation() async {
    try {
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        setState(() { _locating = false;
          _locationError = 'Location services disabled. Please enable GPS.'; });
        return;
      }
      LocationPermission perm = await Geolocator.checkPermission();
      if (perm == LocationPermission.denied) {
        perm = await Geolocator.requestPermission();
        if (perm == LocationPermission.denied) {
          setState(() { _locating = false;
            _locationError = 'Location permission denied.'; });
          return;
        }
      }
      if (perm == LocationPermission.deniedForever) {
        setState(() { _locating = false;
          _locationError = 'Location permanently denied. Enable it in Settings.'; });
        return;
      }
      final pos = await Geolocator.getCurrentPosition(
          desiredAccuracy: LocationAccuracy.high);
      final u = LatLng(pos.latitude, pos.longitude);
      setState(() {
        _userLocation = u; _locating = false;
        _orgs = [
          NearbyOrg(name:'PAWS Animal Welfare',      type:'Animal Shelter',
              emoji:'🏠', color:const Color(0xFFD6EAD8),
              position:LatLng(pos.latitude+0.007, pos.longitude+0.005),
              email:'paws@example.org', phone:'+639171234567', distanceKm:0.8),
          NearbyOrg(name:'City Veterinary Office',   type:'Veterinary Office',
              emoji:'🩺', color:const Color(0xFFCCE5F5),
              position:LatLng(pos.latitude-0.009, pos.longitude+0.008),
              email:'cityvet@example.gov', phone:'+639179876543', distanceKm:1.2),
          NearbyOrg(name:'CARA Welfare Philippines', type:'Animal Organization',
              emoji:'🐾', color:const Color(0xFFEDD9F0),
              position:LatLng(pos.latitude+0.015, pos.longitude-0.010),
              email:'cara@example.org', phone:'+639181234567', distanceKm:2.1),
          NearbyOrg(name:'Happy Paws Clinic',        type:'Veterinary Clinic',
              emoji:'💊', color:const Color(0xFFFFE8D6),
              position:LatLng(pos.latitude-0.016, pos.longitude-0.012),
              email:'happypaws@example.com', phone:'+639191234567', distanceKm:2.4),
          NearbyOrg(name:'ASAP Animal Sanctuary',    type:'Adoption Center',
              emoji:'🌿', color:const Color(0xFFD6EAD8),
              position:LatLng(pos.latitude+0.022, pos.longitude+0.018),
              email:'asap@example.org', phone:'+639201234567', distanceKm:3.0),
        ];
      });
    } catch (e) {
      setState(() { _locating = false;
        _locationError = 'Could not get location: $e'; });
    }
  }

  Future<void> _sendEmail(NearbyOrg org) async {
    final subject = Uri.encodeComponent('Animal Report - AL-AGAP');
    final body    = Uri.encodeComponent(
        'Hello,\n\nReporting a stray animal near '
        '(${_userLocation?.latitude.toStringAsFixed(5)}, '
        '${_userLocation?.longitude.toStringAsFixed(5)}).\n\n'
        'Photo attached.\n\nThank you,\nAL-AGAP User');
    final uri = Uri.parse('mailto:${org.email}?subject=$subject&body=$body');
    if (await canLaunchUrl(uri)) { await launchUrl(uri); }
    else { _showSnack('Could not open email app.'); }
  }

  Future<void> _sendSMS(NearbyOrg org) async {
    final body = Uri.encodeComponent(
        'Hi! Found stray animal near lat:'
        '${_userLocation?.latitude.toStringAsFixed(5)}, '
        'lng:${_userLocation?.longitude.toStringAsFixed(5)}. Via AL-AGAP.');
    final uri = Uri.parse('sms:${org.phone}?body=$body');
    if (await canLaunchUrl(uri)) { await launchUrl(uri); }
    else { _showSnack('SMS not supported on web. Use Email instead.'); }
  }

  void _showSnack(String msg) => ScaffoldMessenger.of(context)
      .showSnackBar(SnackBar(content: Text(msg)));

  void _showOrgSheet(NearbyOrg org) {
    setState(() => _selectedOrg = org);
    showModalBottomSheet(context: context, backgroundColor: Colors.transparent,
      builder: (_) => _OrgBottomSheet(org: org,
        onEmail: () { Navigator.pop(context); _sendEmail(org); },
        onSMS:   () { Navigator.pop(context); _sendSMS(org); }));
  }

  @override
  Widget build(BuildContext context) {
    final arg = ModalRoute.of(context)?.settings.arguments as ImageArg?;

    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(gradient: LinearGradient(
          begin: Alignment.topCenter, end: Alignment.bottomCenter,
          colors: [Color(0xFFF0F8FF), Color(0xFFF5EEF8)])),
        child: SafeArea(
          child: Column(children: [

            // ── Header ──────────────────────────────────────────────────────
            Padding(padding: const EdgeInsets.fromLTRB(16,12,24,4),
              child: Row(children: [
                IconButton(onPressed: () => Navigator.pop(context),
                    icon: const Icon(Icons.arrow_back_ios_new_rounded),
                    color: AppColors.softBrown),
                Text('Report Animal', style: TextStyle(fontSize: 20,
                    fontWeight: FontWeight.bold, color: AppColors.softBrown)),
              ])),

            // ── Photo strip ─────────────────────────────────────────────────
            if (arg != null && arg.hasImage)
              Padding(padding: const EdgeInsets.fromLTRB(20,0,20,8),
                child: SizedBox(height: 90, width: double.infinity,
                  child: ClipRRect(borderRadius: BorderRadius.circular(14),
                      child: buildImage(arg)))),

            // ── Map — takes all remaining space ─────────────────────────────
            Expanded(
              child: Padding(padding: const EdgeInsets.symmetric(horizontal: 20),
                child: ClipRRect(borderRadius: BorderRadius.circular(22),
                  child: _locating
                      ? _loadingTile()
                      : _locationError.isNotEmpty
                          ? _errorTile()
                          : FlutterMap(
                              options: MapOptions(
                                  initialCenter: _userLocation!,
                                  initialZoom: 14.0),
                              children: [
                                // ── CARTO Positron tiles ──
                                // Free, OSM-based, no API key, policy-compliant.
                                // Attribution shown via RichAttributionWidget below.
                                TileLayer(
                                  urlTemplate:
                                    'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
                                  subdomains: const ['a','b','c','d'],
                                  userAgentPackageName: 'com.alagap.app',
                                  maxZoom: 20,
                                ),
                                // ── Required attributions ──
                                RichAttributionWidget(
                                  animationConfig: const ScaleRAWA(),
                                  attributions: [
                                    TextSourceAttribution('© OpenStreetMap contributors',
                                      onTap: () => launchUrl(
                                        Uri.parse('https://openstreetmap.org/copyright'),
                                        mode: LaunchMode.externalApplication)),
                                    TextSourceAttribution('© CARTO',
                                      onTap: () => launchUrl(
                                        Uri.parse('https://carto.com/attributions'),
                                        mode: LaunchMode.externalApplication)),
                                  ],
                                ),
                                MarkerLayer(markers: [
                                  // User pin
                                  Marker(point: _userLocation!, width: 40, height: 40,
                                    child: Container(
                                      decoration: BoxDecoration(
                                          color: AppColors.peach,
                                          shape: BoxShape.circle,
                                          border: Border.all(color: Colors.white, width: 3),
                                          boxShadow: [BoxShadow(
                                              color: AppColors.peach.withOpacity(0.5),
                                              blurRadius: 10)]),
                                      child: const Icon(Icons.person_pin_rounded,
                                          color: Colors.white, size: 20))),
                                  // Org pins
                                  ..._orgs.map((org) => Marker(
                                    point: org.position, width: 44, height: 44,
                                    child: GestureDetector(
                                      onTap: () => _showOrgSheet(org),
                                      child: AnimatedContainer(
                                        duration: const Duration(milliseconds: 200),
                                        decoration: BoxDecoration(
                                          color: _selectedOrg == org
                                              ? AppColors.softBrown : Colors.white,
                                          shape: BoxShape.circle,
                                          border: Border.all(
                                              color: _selectedOrg == org
                                                  ? Colors.white : AppColors.peach,
                                              width: 2),
                                          boxShadow: [BoxShadow(
                                              color: Colors.black.withOpacity(0.15),
                                              blurRadius: 8,
                                              offset: const Offset(0,3))]),
                                        child: Center(child: Text(org.emoji,
                                            style: const TextStyle(fontSize: 20))))))),
                                ]),
                              ]),
                ),
              ),
            ),

            // ── Org list — Flexible prevents overflow in ALL orientations ───
            // Using Flexible (not SizedBox) means the list takes whatever
            // space is left after the map, never exceeding it.
            Flexible(
              flex: 0,
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxHeight: 160),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Padding(padding: const EdgeInsets.fromLTRB(20,8,20,4),
                      child: Text('Nearby Organizations', style: TextStyle(
                          fontSize: 13, fontWeight: FontWeight.bold,
                          color: AppColors.softBrown))),
                    Flexible(
                      child: _locating
                          ? const SizedBox()
                          : ListView.separated(
                              padding: const EdgeInsets.fromLTRB(20,0,20,8),
                              scrollDirection: Axis.horizontal,
                              itemCount: _orgs.length,
                              separatorBuilder: (_, __) => const SizedBox(width: 10),
                              itemBuilder: (_, i) {
                                final org = _orgs[i];
                                final isSel = _selectedOrg == org;
                                return GestureDetector(
                                  onTap: () => _showOrgSheet(org),
                                  child: AnimatedContainer(
                                    duration: const Duration(milliseconds: 200),
                                    width: 125,
