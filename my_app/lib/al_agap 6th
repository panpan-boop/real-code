    _usernameCtrl.dispose(); _bioCtrl.dispose(); super.dispose();
  }

  Future<void> _pickProfilePhoto(ImageSource source) async {
    final XFile? photo = await _picker.pickImage(source: source, imageQuality: 80);
    if (photo == null) return;
    final bytes = await photo.readAsBytes();
    setState(() {
      currentUser?.avatarBytes = bytes;
      currentUser?.avatarEmoji = null;
    });
    await AppUserStore.save();
  }

  // ── FIX: avatar picker uses DraggableScrollableSheet so it never overflows ──
  void _showAvatarPicker() {
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.transparent,
      isScrollControlled: true,       // lets the sheet be taller than 50%
      builder: (_) => DraggableScrollableSheet(
        initialChildSize: 0.55,       // starts at 55% of screen
        minChildSize: 0.4,
        maxChildSize: 0.85,           // can expand to 85%
        expand: false,
        builder: (_, scrollCtrl) => Container(
          decoration: const BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.vertical(top: Radius.circular(28))),
          child: ListView(
            controller: scrollCtrl,   // links scroll to the draggable sheet
            padding: const EdgeInsets.fromLTRB(24, 12, 24, 32),
            children: [
              // Drag handle
              Center(child: Container(width: 40, height: 4,
                margin: const EdgeInsets.only(bottom: 20),
                decoration: BoxDecoration(color: Colors.grey.shade300,
                    borderRadius: BorderRadius.circular(2)))),

              Text('Choose Avatar', style: TextStyle(fontSize: 18,
                  fontWeight: FontWeight.bold, color: AppColors.softBrown)),
              const SizedBox(height: 20),

              // Upload buttons
              Row(children: [
                Expanded(child: _AvatarOptionBtn(
                    icon: Icons.photo_library_outlined, label: 'Gallery',
                    color: AppColors.sky,
                    onTap: () { Navigator.pop(context);
                                _pickProfilePhoto(ImageSource.gallery); })),
                const SizedBox(width: 12),
                Expanded(child: _AvatarOptionBtn(
                    icon: Icons.camera_alt_outlined, label: 'Camera',
                    color: AppColors.sage,
                    onTap: () { Navigator.pop(context);
                                _pickProfilePhoto(ImageSource.camera); })),
              ]),
              const SizedBox(height: 20),

              Text('Or pick an animal avatar:', style: TextStyle(fontSize: 13,
                  color: AppColors.lightText, fontStyle: FontStyle.italic)),
              const SizedBox(height: 12),

              // Emoji grid — inside ListView so it never overflows
              GridView.count(
                crossAxisCount: 6,
                shrinkWrap: true,
                physics: const NeverScrollableScrollPhysics(),
                crossAxisSpacing: 8, mainAxisSpacing: 8,
                children: kPresetAvatars.map((emoji) {
                  final isSel = currentUser?.avatarEmoji == emoji
                      && currentUser?.avatarBytes == null;
                  return GestureDetector(
                    onTap: () async {
                      setState(() {
                        currentUser?.avatarEmoji  = emoji;
                        currentUser?.avatarBytes  = null;
                      });
                      await AppUserStore.save();
                      if (mounted) Navigator.pop(context);
                      setState(() {});
                    },
                    child: AnimatedContainer(
                      duration: const Duration(milliseconds: 150),
                      decoration: BoxDecoration(
                        color: isSel
                            ? AppColors.peach.withOpacity(0.3)
