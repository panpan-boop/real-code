                            color: isSel ? AppColors.peach : Colors.transparent,
                            width: 2)),
                      child: Center(child: Text(emoji,
                          style: const TextStyle(fontSize: 24)))));
                }).toList()),
            ],
          ),
        ),
      ),
    );
