class UserAvatar extends StatelessWidget {
  final AppUser? user;
  final double   size;
  final double   fontSize;
  const UserAvatar({super.key, required this.user, this.size = 44, this.fontSize = 18});

  @override
  Widget build(BuildContext context) {
    if (user == null) {
      return _shell(child: const Icon(Icons.person_rounded, color: Colors.white, size: 22));
    }
    if (user!.avatarBytes != null) {
      return Container(width: size, height: size,
        decoration: BoxDecoration(shape: BoxShape.circle,
          boxShadow: [BoxShadow(color: AppColors.peach.withOpacity(0.3), blurRadius: 8)]),
        child: ClipOval(child: Image.memory(user!.avatarBytes!, fit: BoxFit.cover)));
    }
    if (user!.avatarEmoji != null) {
      return _shell(child: Text(user!.avatarEmoji!,
          style: TextStyle(fontSize: fontSize + 4)));
    }
    return _shell(child: Text(user!.username[0].toUpperCase(),
        style: TextStyle(color: Colors.white, fontSize: fontSize,
            fontWeight: FontWeight.bold)));
  }

  Widget _shell({required Widget child}) {
    return Container(width: size, height: size,
      decoration: BoxDecoration(
        gradient: const LinearGradient(
            colors: [Color(0xFFFFB5A0), Color(0xFFB5D5C5)]),
        shape: BoxShape.circle,
        boxShadow: [BoxShadow(color: AppColors.peach.withOpacity(0.3), blurRadius: 8)]),
      child: Center(child: child));
  }
}

