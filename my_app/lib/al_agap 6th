class LoadingScreen extends StatefulWidget {
  const LoadingScreen({super.key});
  @override State<LoadingScreen> createState() => _LoadingScreenState();
}

class _LoadingScreenState extends State<LoadingScreen> with TickerProviderStateMixin {
  late AnimationController _progressCtrl, _pulseCtrl;
  late Animation<double>   _progressAnim, _pulseAnim;
  int _msgIdx = 0;
  final _msgs = [
    'Waking up the animals... 🐾',
    'Sniffing out nearby shelters... 🐶',
    'Preparing your rescue kit... 🏥',
    'Almost ready to help! 💛',
  ];

  @override
  void initState() {
    super.initState();
    _progressCtrl = AnimationController(vsync: this, duration: const Duration(milliseconds: 3200));
    _pulseCtrl    = AnimationController(vsync: this, duration: const Duration(milliseconds: 900))
      ..repeat(reverse: true);
    _progressAnim = CurvedAnimation(parent: _progressCtrl, curve: Curves.easeInOut);
    _pulseAnim    = Tween(begin: 0.95, end: 1.05).animate(_pulseCtrl);
    _progressCtrl.forward();

    Future.doWhile(() async {
      await Future.delayed(const Duration(milliseconds: 800));
      if (!mounted) return false;
      setState(() => _msgIdx = (_msgIdx + 1) % _msgs.length);
      return _msgIdx != _msgs.length - 1;
    });

    _progressCtrl.addStatusListener((s) {
      if (s == AnimationStatus.completed && mounted) {
        Navigator.pushReplacementNamed(
            context, currentUser != null ? '/home' : '/auth');
      }
    });
  }

  @override
  void dispose() { _progressCtrl.dispose(); _pulseCtrl.dispose(); super.dispose(); }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(gradient: LinearGradient(
          begin: Alignment.topLeft, end: Alignment.bottomRight,
          colors: [Color(0xFFFFF0E8), Color(0xFFFFE4D6), Color(0xFFE8F4EC), Color(0xFFEAE0F8)],
        )),
        child: SafeArea(child: Center(child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 48),
          child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            ScaleTransition(scale: _pulseAnim,
              child: Container(width: 110, height: 110,
                decoration: BoxDecoration(color: Colors.white, shape: BoxShape.circle,
                  boxShadow: [BoxShadow(color: AppColors.peach.withOpacity(0.4), blurRadius: 28, spreadRadius: 4)]),
                child: const Center(child: Text('🐾', style: TextStyle(fontSize: 52))))),
            const SizedBox(height: 40),
            AnimatedSwitcher(
              duration: const Duration(milliseconds: 400),
              child: Text(_msgs[_msgIdx], key: ValueKey(_msgIdx), textAlign: TextAlign.center,
                style: TextStyle(fontSize: 16, color: AppColors.mutedText,
                    fontStyle: FontStyle.italic, height: 1.5))),
            const SizedBox(height: 36),
            Container(height: 8, width: double.infinity,
              decoration: BoxDecoration(color: AppColors.blush.withOpacity(0.4),
                  borderRadius: BorderRadius.circular(8)),
              child: AnimatedBuilder(animation: _progressAnim,
                builder: (_, __) => FractionallySizedBox(
                  alignment: Alignment.centerLeft, widthFactor: _progressAnim.value,
                  child: Container(decoration: BoxDecoration(
                    gradient: const LinearGradient(
                        colors: [Color(0xFFFFB5A0), Color(0xFFB5D5C5)]),
                    borderRadius: BorderRadius.circular(8)))))),
            const SizedBox(height: 16),
            AnimatedBuilder(animation: _progressAnim,
              builder: (_, __) => Text('${(_progressAnim.value * 100).toInt()}%',
                style: TextStyle(fontSize: 13, color: AppColors.lightText,
                    fontWeight: FontWeight.w600))),
          ]),
        ))),
      ),
    );
  }
}

