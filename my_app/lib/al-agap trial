  State<ReportScreen> createState() => _ReportScreenState();
}

class _ReportScreenState extends State<ReportScreen> {
  // Mock nearby organizations
  final List<_NearbyOrg> _orgs = [
    _NearbyOrg(
      name: 'PAWS Animal Welfare',
      type: 'Animal Shelter',
      distance: '0.8 km',
      emoji: '🏠',
      color: const Color(0xFFD6EAD8),
    ),
    _NearbyOrg(
      name: 'City Veterinary Office',
      type: 'Veterinary Office',
      distance: '1.2 km',
      emoji: '🩺',
      color: const Color(0xFFCCE5F5),
    ),
    _NearbyOrg(
      name: 'CARA Welfare Philippines',
      type: 'Animal Organization',
      distance: '2.1 km',
      emoji: '🐾',
      color: const Color(0xFFEDD9F0),
    ),
    _NearbyOrg(
      name: 'Happy Paws Clinic',
      type: 'Veterinary Clinic',
      distance: '2.4 km',
      emoji: '💊',
      color: const Color(0xFFFFE8D6),
    ),
    _NearbyOrg(
      name: 'ASAP Animal Sanctuary',
      type: 'Adoption Center',
      distance: '3.0 km',
      emoji: '🌿',
      color: const Color(0xFFD6EAD8),
    ),
  ];

  String? _selectedOrg;
  bool _sending = false;
  bool _sent = false;

  Future<void> _sendPhoto(String orgName) async {
    setState(() {
      _selectedOrg = orgName;
      _sending = true;
    });
    await Future.delayed(const Duration(seconds: 2));
    setState(() {
      _sending = false;
      _sent = true;
    });
  }

  @override
  Widget build(BuildContext context) {
    final image = ModalRoute.of(context)?.settings.arguments as File?;

    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Color(0xFFF0F8FF), Color(0xFFF5EEF8)],
          ),
        ),
        child: SafeArea(
          child: Column(
            children: [
              // Header
              Padding(
                padding: const EdgeInsets.fromLTRB(16, 16, 24, 0),
                child: Row(
                  children: [
                    IconButton(
                      onPressed: () => Navigator.pop(context),
                      icon: const Icon(Icons.arrow_back_ios_new_rounded),
                      color: AppColors.softBrown,
                    ),
                    Text(
                      'Report Animal',
                      style: TextStyle(
                        fontSize: 22,
                        fontWeight: FontWeight.bold,
                        color: AppColors.softBrown,
                      ),
                    ),
                  ],
                ),
              ),

              Expanded(
                child: _sent
                    ? _buildSuccessView(context)
                    : _buildOrgList(image),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildOrgList(File? image) {
    return ListView(
      padding: const EdgeInsets.all(20),
      children: [
        // Photo preview
        if (image != null)
          Container(
            height: 160,
            margin: const EdgeInsets.only(bottom: 16),
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(20),
              boxShadow: [
                BoxShadow(
                  color: AppColors.sky.withOpacity(0.3),
                  blurRadius: 16,
                  offset: const Offset(0, 6),
                ),
              ],
            ),
            child: ClipRRect(
              borderRadius: BorderRadius.circular(20),
              child: Image.file(image, fit: BoxFit.cover),
            ),
          ),

        // Location badge
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          margin: const EdgeInsets.only(bottom: 20),
          decoration: BoxDecoration(
            color: AppColors.sky.withOpacity(0.4),
            borderRadius: BorderRadius.circular(14),
          ),
          child: Row(
            children: [
              const Icon(Icons.location_on_rounded,
                  color: Color(0xFF4A90C4), size: 20),
              const SizedBox(width: 8),
              Expanded(
                child: Text(
                  'Using your current location to find nearby organizations',
                  style: TextStyle(
                    fontSize: 13,
                    color: AppColors.mutedText,
                  ),
                ),
              ),
            ],
          ),
        ),

        Text(
          'Nearby Organizations',
          style: TextStyle(
            fontSize: 17,
            fontWeight: FontWeight.bold,
            color: AppColors.softBrown,
          ),
        ),
        const SizedBox(height: 4),
        Text(
          'Select where to send the photo',
          style: TextStyle(fontSize: 12, color: AppColors.lightText),
        ),
        const SizedBox(height: 16),

        ..._orgs.map((org) => _buildOrgCard(org)),
      ],
    );
  }

  Widget _buildOrgCard(_NearbyOrg org) {
    final isSelected = _selectedOrg == org.name;

    return GestureDetector(
      onTap: _sending ? null : () => _sendPhoto(org.name),
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 200),
        margin: const EdgeInsets.only(bottom: 12),
        padding: const EdgeInsets.all(16),
        decoration: BoxDecoration(
          color: isSelected ? org.color.withOpacity(0.8) : org.color,
          borderRadius: BorderRadius.circular(18),
          border: Border.all(
            color: isSelected
                ? AppColors.softBrown.withOpacity(0.3)
                : Colors.transparent,
            width: 1.5,
          ),
          boxShadow: [
            BoxShadow(
              color: Colors.black.withOpacity(0.05),
              blurRadius: 8,
              offset: const Offset(0, 3),
            ),
          ],
        ),
        child: Row(
          children: [
            Text(org.emoji, style: const TextStyle(fontSize: 30)),
            const SizedBox(width: 14),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    org.name,
                    style: TextStyle(
                      fontSize: 15,
                      fontWeight: FontWeight.bold,
                      color: AppColors.softBrown,
                    ),
                  ),
                  const SizedBox(height: 3),
                  Text(
                    org.type,
                    style: TextStyle(
                      fontSize: 12,
                      color: AppColors.mutedText,
                    ),
                  ),
                ],
              ),
            ),
            Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Text(
                  org.distance,
                  style: TextStyle(
                    fontSize: 12,
                    fontWeight: FontWeight.w600,
                    color: AppColors.lightText,
                  ),
                ),
                const SizedBox(height: 6),
                if (isSelected && _sending)
                  const SizedBox(
                    width: 18,
                    height: 18,
                    child: CircularProgressIndicator(strokeWidth: 2),
                  )
                else
                  Container(
                    padding:
                        const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                    decoration: BoxDecoration(
                      color: Colors.white.withOpacity(0.6),
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Text(
                      'Send',
                      style: TextStyle(
                        fontSize: 12,
                        fontWeight: FontWeight.bold,
                        color: AppColors.softBrown,
                      ),
                    ),
                  ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSuccessView(BuildContext context) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(36),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              width: 110,
              height: 110,
              decoration: BoxDecoration(
                color: AppColors.sage.withOpacity(0.3),
                shape: BoxShape.circle,
              ),
              child: const Center(
                child: Text('✅', style: TextStyle(fontSize: 52)),
              ),
            ),
            const SizedBox(height: 28),
            Text(
              'Report Sent!',
              style: TextStyle(
                fontSize: 28,
                fontWeight: FontWeight.bold,
                color: AppColors.softBrown,
              ),
            ),
            const SizedBox(height: 12),
            Text(
              'Your photo has been sent to\n$_selectedOrg.\n\nThey will reach out soon.',
              textAlign: TextAlign.center,
              style: TextStyle(
                fontSize: 15,
                color: AppColors.mutedText,
                height: 1.6,
              ),
            ),
            const SizedBox(height: 36),
            GestureDetector(
              onTap: () => Navigator.popUntil(context, (r) => r.isFirst),
              child: Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 36, vertical: 16),
                decoration: BoxDecoration(
                  gradient: const LinearGradient(
                    colors: [Color(0xFFB5D5C5), Color(0xFF8FC4AC)],
