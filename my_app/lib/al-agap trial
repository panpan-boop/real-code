            const SizedBox(width: 14),
            Expanded(
              child: _ActionCard(
                emoji: '📍',
                label: 'Report',
                subtitle: 'Find nearby help',
                color: AppColors.sky,
                onTap: () => Navigator.pushNamed(
                  context,
                  '/report',
                  arguments: _capturedImage,
                ),
              ),
            ),
          ],
        ),
      ],
    );
  }

  Widget _buildHintCards() {
    return Column(
      children: [
        _HintCard(
          emoji: '🏠',
          title: 'Adopt an Animal',
          desc: 'Learn legal steps, paperwork, and vet care for adoption.',
          color: AppColors.sage.withOpacity(0.3),
