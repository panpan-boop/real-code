      child: Row(children: [
        Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          Text('AL-AGAP', style: TextStyle(fontSize: 26, fontWeight: FontWeight.bold, color: AppColors.softBrown, letterSpacing: 3)),
          Text('Rescue • Adopt • Report', style: TextStyle(fontSize: 12, color: AppColors.lightText, letterSpacing: 1.5)),
