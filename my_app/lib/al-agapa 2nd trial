// ─────────────────────────────────────────────────────────────────────────────
// REPORT SCREEN — OpenStreetMap + Geolocator + Email/SMS
// ─────────────────────────────────────────────────────────────────────────────
class ReportScreen extends StatefulWidget {
  const ReportScreen({super.key});
  @override State<ReportScreen> createState() => _ReportScreenState();
}

class _ReportScreenState extends State<ReportScreen> {
  LatLng? _userLocation;
  bool _locating = true;
  String _locationError = '';
  NearbyOrg? _selectedOrg;
  final MapController _mapController = MapController();
  List<NearbyOrg> _orgs = [];

  @override
  void initState() { super.initState(); _getLocation(); }

  Future<void> _getLocation() async {
    try {
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        setState(() { _locating = false; _locationError = 'Location services are disabled. Please enable GPS.'; });
        return;
      }

      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
        if (permission == LocationPermission.denied) {
          setState(() { _locating = false; _locationError = 'Location permission denied.'; });
          return;
        }
      }

      if (permission == LocationPermission.deniedForever) {
        setState(() { _locating = false; _locationError = 'Location permission permanently denied. Enable it in Settings.'; });
        return;
      }

      final pos = await Geolocator.getCurrentPosition(desiredAccuracy: LocationAccuracy.high);
      final userLatLng = LatLng(pos.latitude, pos.longitude);

      setState(() {
        _userLocation = userLatLng;
        _orgs = [
          NearbyOrg(name: 'PAWS Animal Welfare', type: 'Animal Shelter', emoji: '🏠', color: const Color(0xFFD6EAD8),
              position: LatLng(pos.latitude + 0.007, pos.longitude + 0.005), email: 'paws@example.org', phone: '+639171234567', distanceKm: 0.8),
          NearbyOrg(name: 'City Veterinary Office', type: 'Veterinary Office', emoji: '🩺', color: const Color(0xFFCCE5F5),
              position: LatLng(pos.latitude - 0.009, pos.longitude + 0.008), email: 'cityvet@example.gov', phone: '+639179876543', distanceKm: 1.2),
          NearbyOrg(name: 'CARA Welfare Philippines', type: 'Animal Organization', emoji: '🐾', color: const Color(0xFFEDD9F0),
              position: LatLng(pos.latitude + 0.015, pos.longitude - 0.010), email: 'cara@example.org', phone: '+639181234567', distanceKm: 2.1),
          NearbyOrg(name: 'Happy Paws Clinic', type: 'Veterinary Clinic', emoji: '💊', color: const Color(0xFFFFE8D6),
              position: LatLng(pos.latitude - 0.016, pos.longitude - 0.012), email: 'happypaws@example.com', phone: '+639191234567', distanceKm: 2.4),
          NearbyOrg(name: 'ASAP Animal Sanctuary', type: 'Adoption Center', emoji: '🌿', color: const Color(0xFFD6EAD8),
              position: LatLng(pos.latitude + 0.022, pos.longitude + 0.018), email: 'asap@example.org', phone: '+639201234567', distanceKm: 3.0),
        ];
        _locating = false;
      });

      _mapController.move(userLatLng, 14.0);
    } catch (e) {
      setState(() { _locating = false; _locationError = 'Could not get location: $e'; });
    }
  }

  Future<void> _sendEmail(NearbyOrg org) async {
    final subject = Uri.encodeComponent('Animal Report - AL-AGAP');
    final body = Uri.encodeComponent(
      'Hello,\n\nI would like to report a stray animal near my location '
      '(${_userLocation?.latitude.toStringAsFixed(5)}, ${_userLocation?.longitude.toStringAsFixed(5)}).\n\n'
      'Please find the attached photo.\n\nThank you,\nAL-AGAP User');
    final uri = Uri.parse('mailto:${org.email}?subject=$subject&body=$body');
    if (await canLaunchUrl(uri)) {
      await launchUrl(uri);
    } else {
      _showSnack('Could not open email app.');
    }
  }

  Future<void> _sendSMS(NearbyOrg org) async {
    final body = Uri.encodeComponent(
      'Hi! I found a stray animal near lat:${_userLocation?.latitude.toStringAsFixed(5)}, '
      'lng:${_userLocation?.longitude.toStringAsFixed(5)}. Sending via AL-AGAP. Can you help?');
    final uri = Uri.parse('sms:${org.phone}?body=$body');
    if (await canLaunchUrl(uri)) {
      await launchUrl(uri);
    } else {
      _showSnack('Could not open SMS app.');
    }
  }

  void _showSnack(String msg) =>
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(msg)));

  void _showOrgSheet(NearbyOrg org) {
    setState(() => _selectedOrg = org);
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (_) => _OrgBottomSheet(
        org: org,
        onEmail: () { Navigator.pop(context); _sendEmail(org); },
        onSMS: () { Navigator.pop(context); _sendSMS(org); },
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final image = ModalRoute.of(context)?.settings.arguments as File?;

    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(begin: Alignment.topCenter, end: Alignment.bottomCenter,
            colors: [Color(0xFFF0F8FF), Color(0xFFF5EEF8)]),
        ),
        child: SafeArea(child: Column(children: [
          // Header
          Padding(padding: const EdgeInsets.fromLTRB(16, 16, 24, 8),
            child: Row(children: [
              IconButton(onPressed: () => Navigator.pop(context), icon: const Icon(Icons.arrow_back_ios_new_rounded), color: AppColors.softBrown),
              Text('Report Animal', style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: AppColors.softBrown)),
            ]),
          ),

          // Photo strip
          if (image != null)
            Padding(padding: const EdgeInsets.fromLTRB(20, 0, 20, 12),
              child: Container(height: 110, width: double.infinity,
                decoration: BoxDecoration(borderRadius: BorderRadius.circular(16),
                  boxShadow: [BoxShadow(color: AppColors.sky.withOpacity(0.3), blurRadius: 12, offset: const Offset(0, 4))]),
                child: ClipRRect(borderRadius: BorderRadius.circular(16), child: Image.file(image, fit: BoxFit.cover)))),

          // Map
          Expanded(flex: 5,
            child: Padding(padding: const EdgeInsets.symmetric(horizontal: 20),
              child: ClipRRect(borderRadius: BorderRadius.circular(24),
                child: _locating
                    ? Container(color: AppColors.sky.withOpacity(0.2),
                        child: Center(child: Column(mainAxisSize: MainAxisSize.min, children: [
                          const CircularProgressIndicator(),
                          const SizedBox(height: 12),
                          Text('Getting your location...', style: TextStyle(color: AppColors.mutedText)),
                        ])))
                    : _locationError.isNotEmpty
                        ? Container(color: AppColors.blush.withOpacity(0.3),
                            child: Center(child: Padding(padding: const EdgeInsets.all(24),
                              child: Text(_locationError, textAlign: TextAlign.center, style: TextStyle(color: AppColors.mutedText)))))
                        : FlutterMap(
                            mapController: _mapController,
                            options: MapOptions(initialCenter: _userLocation!, initialZoom: 14.0),
                            children: [
                              TileLayer(urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png', userAgentPackageName: 'com.alagap.app'),
                              MarkerLayer(markers: [
                                // User marker
                                Marker(point: _userLocation!, width: 40, height: 40,
                                  child: Container(
                                    decoration: BoxDecoration(color: AppColors.peach, shape: BoxShape.circle,
                                      border: Border.all(color: Colors.white, width: 3),
                                      boxShadow: [BoxShadow(color: AppColors.peach.withOpacity(0.5), blurRadius: 10)]),
                                    child: const Icon(Icons.person_pin_rounded, color: Colors.white, size: 20),
                                  )),
                                // Org markers
                                ..._orgs.map((org) => Marker(point: org.position, width: 44, height: 44,
                                  child: GestureDetector(onTap: () => _showOrgSheet(org),
                                    child: AnimatedContainer(duration: const Duration(milliseconds: 200),
                                      decoration: BoxDecoration(
                                        color: _selectedOrg == org ? AppColors.softBrown : Colors.white,
                                        shape: BoxShape.circle,
                                        border: Border.all(color: _selectedOrg == org ? Colors.white : AppColors.peach, width: 2),
                                        boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.15), blurRadius: 8, offset: const Offset(0, 3))]),
                                      child: Center(child: Text(org.emoji, style: const TextStyle(fontSize: 20))),
                                    ),
                                  ))),
                              ]),
                            ],
                          ),
              ),
            ),
          ),

          // Org horizontal list
          Expanded(flex: 3, child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Padding(padding: const EdgeInsets.fromLTRB(20, 14, 20, 8),
              child: Text('Nearby Organizations', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: AppColors.softBrown))),
            Expanded(child: _locating ? const SizedBox() : ListView.separated(
              padding: const EdgeInsets.symmetric(horizontal: 20),
              scrollDirection: Axis.horizontal,
              itemCount: _orgs.length,
              separatorBuilder: (_, __) => const SizedBox(width: 12),
              itemBuilder: (_, i) {
                final org = _orgs[i];
                final isSelected = _selectedOrg == org;
                return GestureDetector(onTap: () => _showOrgSheet(org),
                  child: AnimatedContainer(duration: const Duration(milliseconds: 200),
                    width: 155, padding: const EdgeInsets.all(14),
                    decoration: BoxDecoration(
                      color: isSelected ? org.color.withOpacity(0.9) : org.color.withOpacity(0.5),
                      borderRadius: BorderRadius.circular(18),
                      border: Border.all(color: isSelected ? AppColors.softBrown.withOpacity(0.4) : Colors.transparent, width: 2)),
                    child: Column(crossAxisAlignment: CrossAxisAlignment.start, mainAxisAlignment: MainAxisAlignment.center, children: [
                      Text(org.emoji, style: const TextStyle(fontSize: 26)),
                      const SizedBox(height: 8),
                      Text(org.name, maxLines: 2, overflow: TextOverflow.ellipsis,
                          style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: AppColors.softBrown)),
                      const SizedBox(height: 3),
                      Text(org.distanceLabel, style: TextStyle(fontSize: 11, color: AppColors.lightText)),
                      const SizedBox(height: 8),
                      Container(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                        decoration: BoxDecoration(color: Colors.white.withOpacity(0.6), borderRadius: BorderRadius.circular(10)),
                        child: Text('Contact', style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, color: AppColors.softBrown))),
                    ]),
                  ),
                );
              },
            )),
            const SizedBox(height: 16),
          ])),
        ])),
      ),
    );
  }
}

