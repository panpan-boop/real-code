// IMAGE ARG — handles both File (mobile) and Uint8List (web)
// ═══════════════════════════════════════════════════════════════════════════
class ImageArg {
  final File?      file;
  final Uint8List? bytes;
  final String?    webUrl; // object URL for web to avoid decode errors
  const ImageArg({this.file, this.bytes, this.webUrl});
  bool get hasImage => file != null || bytes != null || webUrl != null;
}

// FIX: on web use Image.network with object URL to avoid encoding errors
Widget buildImage(ImageArg? a, {BoxFit fit = BoxFit.cover}) {
  if (a == null || !a.hasImage) return const SizedBox.shrink();
  if (a.webUrl != null) return Image.network(a.webUrl!, fit: fit);
  if (a.bytes != null) return Image.memory(a.bytes!, fit: fit, errorBuilder: (_,__,___) =>
    Container(color: Colors.grey.shade200, child: const Icon(Icons.broken_image, color: Colors.grey)));
  return Image.file(a.file!, fit: fit);
}

