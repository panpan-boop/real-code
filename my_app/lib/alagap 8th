// Nominatim search — simple query, no OR operator
Future<List<OrgPin>> searchNominatim(String q, LatLng? center) async {
  // Search multiple terms separately and merge
  final terms = ['veterinary $q','animal shelter $q','pet clinic $q','animal welfare $q'];
  final dist  = const Distance();
  final List<OrgPin> results = [];
  final Set<String> seen = {};

  for (final term in terms) {
    final encoded = Uri.encodeComponent(term);
    final url = 'https://nominatim.openstreetmap.org/search'
      '?q=$encoded&format=json&limit=5&addressdetails=0';
    try {
      final resp = await http.get(Uri.parse(url),
        headers: {'User-Agent':'AL-AGAP/1.0 alagap.philippines@gmail.com',
                  'Accept-Language':'en'})
        .timeout(const Duration(seconds: 10));
      if (resp.statusCode != 200) continue;
      final data = jsonDecode(resp.body) as List;
      for (final el in data) {
        final name = (el['display_name'] ?? '').toString().split(',').first.trim();
        if (seen.contains(name) || name.isEmpty) continue;
        seen.add(name);
        final lat = double.tryParse(el['lat']?.toString() ?? '') ?? 0;
        final lng = double.tryParse(el['lon']?.toString() ?? '') ?? 0;
        if (lat == 0 && lng == 0) continue;
        final pos = LatLng(lat, lng);
        final km  = center != null ? dist.as(LengthUnit.Kilometer, center, pos) : 0.0;
        results.add(OrgPin(name:name, type:OrgType.other, position:pos, distanceKm:km));
      }
    } catch(_) { continue; }
  }
  results.sort((a,b)=>a.distanceKm.compareTo(b.distanceKm));
  return results;
}

// Nominatim autocomplete suggestions
Future<List<String>> nominatimSuggest(String q) async {
  if (q.trim().length < 2) return [];
  final encoded = Uri.encodeComponent('$q animal');
  final url = 'https://nominatim.openstreetmap.org/search'
    '?q=$encoded&format=json&limit=5&addressdetails=0';
  try {
    final resp = await http.get(Uri.parse(url),
      headers: {'User-Agent':'AL-AGAP/1.0 alagap.philippines@gmail.com'})
      .timeout(const Duration(seconds: 8));
    if (resp.statusCode != 200) return [];
    final data = jsonDecode(resp.body) as List;
    return data.map((e)=>(e['display_name']??'').toString().split(',').first.trim())
      .where((s)=>s.isNotEmpty).take(5).toList();
  } catch(_) { return []; }
}

