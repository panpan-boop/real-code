// ═══════════════════════════════════════════════════════════════════════════
class AppUser {
  String username, email; String? bio;
  int reportsCount, adoptionsCount, coins, streak;
  Map<String,int> coinLog; // key: YYYY-MM-DD, value: coins earned
  String? avatarEmoji; Uint8List? avatarBytes;

  AppUser({required this.username, required this.email, this.bio,
    this.reportsCount=0, this.adoptionsCount=0, this.coins=0, this.streak=0,
    Map<String,int>? coinLog, this.avatarEmoji, this.avatarBytes})
    : coinLog = coinLog ?? {};

  // Days logged this month
  Set<int> get loggedDaysThisMonth {
    final p = _mp();
    return coinLog.keys.where((k)=>k.startsWith(p))
      .map((k)=>int.parse(k.split('-')[2])).toSet();
  }
  // Total coins from login this month
  int get monthlyLoginCoins {
    final p = _mp();
    return coinLog.entries.where((e)=>e.key.startsWith(p)).fold(0,(s,e)=>s+e.value);
  }
  static String _mp() { final n=DateTime.now();
    return '${n.year}-${n.month.toString().padLeft(2,'0')}'; }
  static String todayKey() { final n=DateTime.now();
    return '${n.year}-${n.month.toString().padLeft(2,'0')}-${n.day.toString().padLeft(2,'0')}'; }
  static String yesterdayKey() {
    final y=DateTime.now().subtract(const Duration(days:1));
    return '${y.year}-${y.month.toString().padLeft(2,'0')}-${y.day.toString().padLeft(2,'0')}'; }
}

AppUser? currentUser;
bool appDarkMode = false;

// ═══════════════════════════════════════════════════════════════════════════
// STORE
// ═══════════════════════════════════════════════════════════════════════════
class AppStore {
  static const _U='u_n',_E='u_e',_B='u_b',_R='u_r',_A='u_a',_C='u_c',
    _ST='u_st',_CL='u_cl',_AE='u_ae',_AB='u_ab',_DM='app_dm',_SH='s_h';

  static Future<void> load() async {
    final p = await SharedPreferences.getInstance();
    appDarkMode = p.getBool(_DM) ?? false;
    themeNotifier.value = appDarkMode;
    final un = p.getString(_U);
    if (un != null) {
      Uint8List? av;
      final b64 = p.getString(_AB);
      if (b64 != null) try { av=base64Decode(b64); } catch(_){}
      Map<String,int> cl = {};
      final lj = p.getString(_CL);
      if (lj != null) try {
        final m = jsonDecode(lj) as Map;
        cl = m.map((k,v)=>MapEntry(k.toString(),(v as num).toInt()));
      } catch(_){}
      currentUser = AppUser(
        username:un, email:p.getString(_E)??'', bio:p.getString(_B),
        reportsCount:p.getInt(_R)??0, adoptionsCount:p.getInt(_A)??0,
        coins:p.getInt(_C)??0, streak:p.getInt(_ST)??0,
        coinLog:cl, avatarEmoji:p.getString(_AE), avatarBytes:av);
    }
  }

  static Future<void> save() async {
    if (currentUser==null) return;
    final p = await SharedPreferences.getInstance();
    await p.setString(_U, currentUser!.username);
    await p.setString(_E, currentUser!.email);
    if (currentUser!.bio!=null) await p.setString(_B,currentUser!.bio!); else await p.remove(_B);
    await p.setInt(_R, currentUser!.reportsCount);
    await p.setInt(_A, currentUser!.adoptionsCount);
    await p.setInt(_C, currentUser!.coins);
    await p.setInt(_ST, currentUser!.streak);
    await p.setString(_CL, jsonEncode(currentUser!.coinLog));
    if (currentUser!.avatarEmoji!=null) await p.setString(_AE,currentUser!.avatarEmoji!); else await p.remove(_AE);
    if (currentUser!.avatarBytes!=null) await p.setString(_AB,base64Encode(currentUser!.avatarBytes!)); else await p.remove(_AB);
    await p.setBool(_DM, appDarkMode);
  }

  static Future<void> clear() async {
    final p = await SharedPreferences.getInstance(); await p.clear();
  }

  /// Streak-based daily bonus:
  /// Coins per day = min(streak, max daily so that ~100 total in 30 days)
  /// Day 1→1, Day 2→2 ... Day 7→7, cap at 7 thereafter (7*14+sum1..6 = 98+21 = ~100 in 30 days)
  /// Returns (bonusGranted, coinsEarned, newStreak)
  static Future<(bool, int, int)> checkDailyBonus() async {
    if (currentUser==null) return (false,0,0);
    final today = AppUser.todayKey();
    final yesterday = AppUser.yesterdayKey();
    if (currentUser!.coinLog.containsKey(today)) return (false,0,currentUser!.streak);

    // Streak logic
    final hadYesterday = currentUser!.coinLog.containsKey(yesterday);
    final newStreak = hadYesterday ? currentUser!.streak + 1 : 1;
    // Coins = min(newStreak, 7)
    final coinsToday = math.min(newStreak, 7);

    currentUser!.streak = newStreak;
    currentUser!.coinLog[today] = coinsToday;
    currentUser!.coins += coinsToday;
    await save();
    return (true, coinsToday, newStreak);
  }

  static Future<void> resetStreak() async {
    if (currentUser==null) return;
    currentUser!.streak = 0;
    await save();
  }

  static Future<List<String>> getSearchHistory() async {
    final p = await SharedPreferences.getInstance();
    return p.getStringList(_SH) ?? [];
  }

  static Future<void> addSearch(String q) async {
    if (q.trim().isEmpty) return;
    final p = await SharedPreferences.getInstance();
    final h = p.getStringList(_SH) ?? [];
    h.remove(q); h.insert(0,q);
    if (h.length>20) h.removeLast();
    await p.setStringList(_SH,h);
  }

  static Future<void> clearSearchHistory() async {
    final p = await SharedPreferences.getInstance(); await p.remove(_SH);
  }
}

