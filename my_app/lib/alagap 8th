// OVERPASS API — with CORS proxy for web
// Uses overpass-api.de directly on mobile, proxy on web
// ═══════════════════════════════════════════════════════════════════════════
Future<List<OrgPin>> fetchOverpassOrgs(LatLng center, double radiusKm) async {
  final r = (radiusKm * 1000).toInt();
  final lat = center.latitude, lng = center.longitude;

  // Broad query covering all animal-related establishments
  final query = '''
[out:json][timeout:30];
(
  node["amenity"="veterinary"](around:$r,$lat,$lng);
  way["amenity"="veterinary"](around:$r,$lat,$lng);
  node["amenity"="animal_shelter"](around:$r,$lat,$lng);
  way["amenity"="animal_shelter"](around:$r,$lat,$lng);
  node["amenity"="animal_boarding"](around:$r,$lat,$lng);
  node["shop"="pet"](around:$r,$lat,$lng);
  way["shop"="pet"](around:$r,$lat,$lng);
  node["amenity"="animal_clinic"](around:$r,$lat,$lng);
  node["healthcare"="veterinary"](around:$r,$lat,$lng);
  node["animal"="shelter"](around:$r,$lat,$lng);
  node["animal"="clinic"](around:$r,$lat,$lng);
  node["name"~"[Vv]et",i](around:$r,$lat,$lng);
  node["name"~"[Aa]nimal",i](around:$r,$lat,$lng);
  node["name"~"[Pp]aws",i](around:$r,$lat,$lng);
  node["name"~"[Ss]helter",i](around:$r,$lat,$lng);
  node["name"~"[Cc]linic",i](around:$r,$lat,$lng);
);
out center;
''';

  // On web use allorigins CORS proxy; on mobile call directly
  final Uri uri;
  if (kIsWeb) {
    final encoded = Uri.encodeComponent(
      'https://overpass-api.de/api/interpreter?data=${Uri.encodeComponent(query)}');
    uri = Uri.parse('https://api.allorigins.win/get?url=$encoded');
  } else {
    uri = Uri.parse('https://overpass-api.de/api/interpreter');
  }

  try {
    http.Response resp;
    if (kIsWeb) {
      resp = await http.get(uri,
        headers: {'User-Agent':'AL-AGAP/1.0 alagap.philippines@gmail.com'})
        .timeout(const Duration(seconds: 30));
    } else {
      resp = await http.post(uri, body: query,
        headers: {'Content-Type':'application/x-www-form-urlencoded'})
        .timeout(const Duration(seconds: 30));
    }
    if (resp.statusCode != 200) return _fallbackOrgs(center);

    Map<String,dynamic> data;
    if (kIsWeb) {
      // allorigins wraps response in {"contents":"...","status":{}}
      final wrapper = jsonDecode(resp.body) as Map<String,dynamic>;
      final contents = wrapper['contents'] as String? ?? '{}';
      data = jsonDecode(contents) as Map<String,dynamic>;
    } else {
      data = jsonDecode(resp.body) as Map<String,dynamic>;
    }

    final elements = (data['elements'] as List?) ?? [];
    if (elements.isEmpty) return _fallbackOrgs(center);

    final dist = const Distance();
    final List<OrgPin> pins = [];
    final Set<String> seen = {};

    for (final el in elements) {
      final tags = (el['tags'] as Map<String,dynamic>?) ?? {};
      final name = (tags['name'] ?? tags['operator'] ?? 'Unnamed Organization').toString();
      if (seen.contains(name)) continue;
      seen.add(name);

      double? elat, elng;
      if (el['type'] == 'node') {
        elat = (el['lat'] as num?)?.toDouble();
        elng = (el['lon'] as num?)?.toDouble();
      } else if (el['center'] != null) {
        elat = (el['center']['lat'] as num?)?.toDouble();
        elng = (el['center']['lon'] as num?)?.toDouble();
      }
      if (elat == null || elng == null) continue;

      final pos = LatLng(elat, elng);
      final km  = dist.as(LengthUnit.Kilometer, center, pos);

      final amenity = (tags['amenity'] ?? '').toString().toLowerCase();
      final shop    = (tags['shop']    ?? '').toString().toLowerCase();
      final health  = (tags['healthcare'] ?? '').toString().toLowerCase();
      final nameLow = name.toLowerCase();

      OrgType t = OrgType.other;
      if (amenity=='veterinary' || health=='veterinary') t = OrgType.vet;
      else if (amenity=='animal_shelter' || amenity=='animal') t = OrgType.shelter;
      else if (shop=='pet') t = OrgType.clinic;
      else if (amenity=='animal_boarding') t = OrgType.welfare;
      else if (nameLow.contains('vet') || nameLow.contains('clinic')) t = OrgType.vet;
      else if (nameLow.contains('shelter') || nameLow.contains('rescue')) t = OrgType.shelter;
      else if (nameLow.contains('paws') || nameLow.contains('animal')) t = OrgType.welfare;

      pins.add(OrgPin(name:name, type:t, position:pos,
        phone: tags['phone']?.toString(),
        website: tags['website']?.toString(),
        distanceKm: km));
    }

    pins.sort((a,b) => a.distanceKm.compareTo(b.distanceKm));
    // If overpass returned results, return them; else fallback
    return pins.isNotEmpty ? pins : _fallbackOrgs(center);
  } catch (e) {
    return _fallbackOrgs(center);
  }
}

