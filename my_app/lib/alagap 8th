  const ReportScreen({super.key});
  @override State<ReportScreen> createState() => _ReportScreenState();
}
class _ReportScreenState extends State<ReportScreen> {
  LatLng? _loc; bool _locating=true; String _locErr='';
  double _radius=10.0; List<OrgPin> _orgs=[]; bool _fetching=false; OrgPin? _sel;
  final _sc=TextEditingController();
  bool _showS=false,_searching=false;
  List<OrgPin> _sResults=[]; List<String> _sHist=[]; List<String> _suggestions=[];

  @override void initState(){super.initState();_init();}
  @override void dispose(){_sc.dispose();super.dispose();}

  Future<void> _init() async {
    final h=await AppStore.getSearchHistory(); setState(()=>_sHist=h);
    await _getLoc(); }

  Future<void> _getLoc() async {
    setState((){_locating=true;_locErr='';});
    try {
      if(!await Geolocator.isLocationServiceEnabled()){setState((){_locating=false;_locErr='Location services disabled.';});return;}
      var p=await Geolocator.checkPermission();
      if(p==LocationPermission.denied) p=await Geolocator.requestPermission();
      if(p==LocationPermission.denied||p==LocationPermission.deniedForever){setState((){_locating=false;_locErr='Location permission denied.';});return;}
      final pos=await Geolocator.getCurrentPosition(desiredAccuracy:LocationAccuracy.high);
      setState((){_loc=LatLng(pos.latitude,pos.longitude);_locating=false;});
      await _fetchOrgs();
    } catch(e){setState((){_locating=false;_locErr='Could not get location: $e';});}
  }

  Future<void> _fetchOrgs() async {
    if(_loc==null)return; setState(()=>_fetching=true);
    final o=await fetchOverpassOrgs(_loc!,_radius);
    setState((){_orgs=o;_fetching=false;}); }

  Future<void> _onSearchChanged(String q) async {
    if(q.trim().length<2){setState((){_suggestions=[];});return;}
    final s=await nominatimSuggest(q);
    setState((){_suggestions=s;}); }

  Future<void> _doSearch(String q) async {
    if(q.trim().isEmpty)return;
    _sc.text=q; FocusScope.of(context).unfocus();
    await AppStore.addSearch(q);
    final h=await AppStore.getSearchHistory();
    setState((){_searching=true;_sHist=h;_suggestions=[];});
    final r=await searchNominatim(q,_loc);
    setState((){_sResults=r;_searching=false;}); }

  Future<void> _email(OrgPin o) async {
    final sub=Uri.encodeComponent('Animal Report - AL-AGAP');
    final body=Uri.encodeComponent('Hello,\n\nReporting a stray animal at (${_loc?.latitude.toStringAsFixed(5)}, ${_loc?.longitude.toStringAsFixed(5)}).\n\nVia AL-AGAP app.\n\nThank you.');
    final uri=Uri.parse('mailto:?subject=$sub&body=$body');
    if(await canLaunchUrl(uri)) await launchUrl(uri); else _snack('Could not open email.');}
  Future<void> _sms(OrgPin o) async {
    final body=Uri.encodeComponent('Hi! Found stray animal near ${_loc?.latitude.toStringAsFixed(5)},${_loc?.longitude.toStringAsFixed(5)}. Via AL-AGAP.');
    final uri=Uri.parse('sms:${o.phone??''}?body=$body');
    if(await canLaunchUrl(uri)) await launchUrl(uri); else _snack('SMS not supported on web.');}
  void _snack(String m)=>ScaffoldMessenger.of(context).showSnackBar(SnackBar(content:Text(m)));
  void _sheet(OrgPin o){setState(()=>_sel=o);showModalBottomSheet(context:context,backgroundColor:Colors.transparent,isScrollControlled:true,
    builder:(_)=>_OrgSheet(org:o,dark:isDark(context),
      onEmail:(){Navigator.pop(context);_email(o);},
