  Future<void> _pickPhoto(ImageSource src) async {
    // Use low quality + small max dimensions to prevent web lag
    final x=await _picker.pickImage(source:src,imageQuality:50,maxWidth:400,maxHeight:400);
    if(x==null) return;
    final raw=await x.readAsBytes();
    // Cap at 150KB for SharedPreferences performance
    final capped = raw.length>150*1024 ? Uint8List.fromList(raw.sublist(0,150*1024)) : raw;
    setState((){currentUser?.avatarBytes=capped;currentUser?.avatarEmoji=null;});
    await AppStore.save();
  }

