// ─── Streak-based coin calendar ──────────────────────────────────────────
class _Calendar extends StatelessWidget {
  final AppUser? user; final bool d;
  const _Calendar({required this.user,required this.d});
  @override Widget build(BuildContext context) {
    final now=DateTime.now();
    final monthName=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][now.month-1];
    final dim=DateUtils.getDaysInMonth(now.year,now.month);
    final fw=DateTime(now.year,now.month,1).weekday%7; // 0=Sun
    final logged=user?.loggedDaysThisMonth??{};
    final monthly=user?.monthlyLoginCoins??0;
    final streak=user?.streak??0;
    final sb=AC.softBrown(d); final lt=AC.lightText(d);
    // Theoretical max per month (streak caps at 7, ~100 total over 30 days)
    const maxMonth=100;
    return Container(padding:const EdgeInsets.all(16),
      decoration:BoxDecoration(gradient:LinearGradient(colors:[AC.gold.withOpacity(0.1),AC.blush(d).withOpacity(0.15)]),
        borderRadius:BorderRadius.circular(20),border:Border.all(color:AC.gold.withOpacity(0.3),width:1.5)),
      child:Column(children:[
        // Month/year header + coin total
        Row(children:[
          Text('$monthName ${now.year}',style:TextStyle(fontSize:15,fontWeight:FontWeight.bold,color:sb)),
          const Spacer(),
          const Text('🪙',style:TextStyle(fontSize:16)),const SizedBox(width:4),
          Text('$monthly/$maxMonth this month',style:TextStyle(fontSize:12,color:lt,fontWeight:FontWeight.w600)),
        ]),
        const SizedBox(height:6),
        // Progress
        ClipRRect(borderRadius:BorderRadius.circular(4),child:LinearProgressIndicator(
          value:monthly/maxMonth,minHeight:5,backgroundColor:AC.blush(d).withOpacity(0.3),
          valueColor:const AlwaysStoppedAnimation<Color>(AC.gold))),
        const SizedBox(height:4),
        Row(mainAxisAlignment:MainAxisAlignment.spaceBetween,children:[
          Text('Streak: $streak day${streak!=1?'s':''}  🔥',style:TextStyle(fontSize:11,color:AC.streak,fontWeight:FontWeight.bold)),
          Text('Next login: +${math.min(streak+1,7)} 🪙',style:TextStyle(fontSize:11,color:lt)),
        ]),
        const SizedBox(height:10),
        // Day labels
        Row(mainAxisAlignment:MainAxisAlignment.spaceAround,
          children:['S','M','T','W','T','F','S'].map((x)=>SizedBox(width:26,
            child:Text(x,textAlign:TextAlign.center,style:TextStyle(fontSize:9,fontWeight:FontWeight.bold,color:lt)))).toList()),
        const SizedBox(height:4),
        // Calendar grid
        GridView.builder(shrinkWrap:true,physics:const NeverScrollableScrollPhysics(),
          gridDelegate:const SliverGridDelegateWithFixedCrossAxisCount(crossAxisCount:7,mainAxisSpacing:3,crossAxisSpacing:3,childAspectRatio:1),
          itemCount:fw+dim,
          itemBuilder:(_,i){
            if(i<fw) return const SizedBox.shrink();
            final day=i-fw+1;
            final isL=logged.contains(day);
            final isT=day==now.day;
            final coinVal=user?.coinLog[_dayKey(now.year,now.month,day)]??0;
            return Container(decoration:BoxDecoration(
              color:isL?AC.gold.withOpacity(0.8):isT?AC.peach(d).withOpacity(0.35):Colors.transparent,
              borderRadius:BorderRadius.circular(5),
              border:isT?Border.all(color:AC.peach(d),width:1.5):null),
              child:Center(child:isL&&coinVal>0
                ?Column(mainAxisAlignment:MainAxisAlignment.center,children:[
                    Text('$day',style:TextStyle(fontSize:8,fontWeight:FontWeight.bold,color:Colors.white)),
                    Text('+$coinVal',style:const TextStyle(fontSize:7,color:Colors.white,fontWeight:FontWeight.bold))])
                :Text('$day',style:TextStyle(fontSize:9,fontWeight:isT?FontWeight.bold:FontWeight.normal,color:isL?Colors.white:sb))));
          }),
      ]));
  }
  static String _dayKey(int y,int m,int day)=>'$y-${m.toString().padLeft(2,'0')}-${day.toString().padLeft(2,'0')}';
}

