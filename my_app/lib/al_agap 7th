class AppUser {
  String username, email; String? bio;
  int reportsCount, adoptionsCount, coins;
  Map<String,int> coinLog;
  String? avatarEmoji; Uint8List? avatarBytes;

  AppUser({required this.username, required this.email, this.bio,
    this.reportsCount=0, this.adoptionsCount=0, this.coins=0,
    Map<String,int>? coinLog, this.avatarEmoji, this.avatarBytes})
    : coinLog = coinLog ?? {};

  int get monthlyCoins {
    final p = _monthPrefix();
    return coinLog.entries.where((e)=>e.key.startsWith(p)).fold(0,(s,e)=>s+e.value);
  }
  Set<int> get loggedDaysThisMonth {
    final p = _monthPrefix();
    return coinLog.keys.where((k)=>k.startsWith(p)).map((k)=>int.parse(k.split('-')[2])).toSet();
  }
  static String _monthPrefix() {
    final n=DateTime.now();
    return '${n.year}-${n.month.toString().padLeft(2,'0')}';
  }
}

