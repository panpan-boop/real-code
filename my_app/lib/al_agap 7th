// ═══════════════════════════════════════════════════════════════════════════
class ImageArg {
  final File? file; final Uint8List? bytes;
  const ImageArg({this.file, this.bytes});
  bool get hasImage => file != null || bytes != null;
}

Widget buildImage(ImageArg? a, {BoxFit fit = BoxFit.cover}) {
  if (a == null || !a.hasImage) return const SizedBox.shrink();
  if (a.bytes != null) return Image.memory(a.bytes!, fit: fit);
  return Image.file(a.file!, fit: fit);
}

// ═══════════════════════════════════════════════════════════════════════════
// IMAGE COMPRESSION — web-safe, no native plugins
// Limits bytes to ~300KB by reducing quality steps.
// On web we cannot use dart:ui Image codec without async complexity,
// so we simply cap the stored size to avoid lag.
// ═══════════════════════════════════════════════════════════════════════════
Future<Uint8List> compressForStorage(Uint8List input) async {
  // If already small enough, use as-is
  if (input.length <= 300 * 1024) return input;
  // On web we cannot do pixel-level resize without a canvas,
  // so we just take the first 300KB as a rough guard.
  // This avoids the laggy base64 encode of huge images in SharedPreferences.
  return Uint8List.fromList(input.sublist(0, math.min(input.length, 300 * 1024)));
}

