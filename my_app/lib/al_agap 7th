enum OrgType { shelter, vet, welfare, clinic, other }

class OrgPin {
  final String  name; final OrgType type; final LatLng position;
  final String? phone; final String? website; final double distanceKm;
  const OrgPin({required this.name, required this.type, required this.position,
    this.phone, this.website, required this.distanceKm});

  String get typeLabel { switch(type) {
    case OrgType.shelter: return 'Animal Shelter';
    case OrgType.vet:     return 'Veterinary';
    case OrgType.welfare: return 'Animal Welfare';
    case OrgType.clinic:  return 'Vet Clinic';
    case OrgType.other:   return 'Animal Org';
  }}
  String get emoji { switch(type) {
    case OrgType.shelter: return '🏠';
    case OrgType.vet:     return '🩺';
    case OrgType.welfare: return '🐾';
    case OrgType.clinic:  return '💊';
    case OrgType.other:   return '🌿';
  }}
  Color pinColor(bool d) { switch(type) {
    case OrgType.shelter: return AC.sage(d);
    case OrgType.vet:     return AC.sky(d);
    case OrgType.welfare: return AC.lavender(d);
    case OrgType.clinic:  return d ? const Color(0xFF6A4A2A) : const Color(0xFFFFE8D6);
    case OrgType.other:   return d ? const Color(0xFF3A5A3A) : const Color(0xFFD6EAD8);
  }}
  String get distanceLabel => distanceKm < 1
    ? '${(distanceKm*1000).toInt()} m' : '${distanceKm.toStringAsFixed(1)} km';
}

