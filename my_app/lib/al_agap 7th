class AppStore {
  static const _kU='u_n',_kE='u_e',_kB='u_b',_kR='u_r',_kA='u_a',_kC='u_c',
    _kCL='u_cl',_kAE='u_ae',_kAB='u_ab',_kDM='app_dm',_kSH='s_h';

  static Future<void> load() async {
    final p = await SharedPreferences.getInstance();
    appDarkMode = p.getBool(_kDM) ?? false;
    final un = p.getString(_kU);
    if (un != null) {
      Uint8List? av;
      final b64 = p.getString(_kAB);
      if (b64 != null) try { av=base64Decode(b64); } catch(_){}
      Map<String,int> cl = {};
      final lj = p.getString(_kCL);
      if (lj != null) try { final m=jsonDecode(lj) as Map; cl=m.map((k,v)=>MapEntry(k.toString(),v as int)); } catch(_){}
      currentUser = AppUser(
        username: un, email: p.getString(_kE)??'', bio: p.getString(_kB),
        reportsCount: p.getInt(_kR)??0, adoptionsCount: p.getInt(_kA)??0,
        coins: p.getInt(_kC)??0, coinLog: cl,
        avatarEmoji: p.getString(_kAE), avatarBytes: av);
    }
  }

  static Future<void> save() async {
    if (currentUser==null) return;
    final p = await SharedPreferences.getInstance();
    await p.setString(_kU, currentUser!.username);
    await p.setString(_kE, currentUser!.email);
    if (currentUser!.bio!=null) await p.setString(_kB,currentUser!.bio!); else await p.remove(_kB);
    await p.setInt(_kR,currentUser!.reportsCount);
    await p.setInt(_kA,currentUser!.adoptionsCount);
    await p.setInt(_kC,currentUser!.coins);
    await p.setString(_kCL,jsonEncode(currentUser!.coinLog));
    if (currentUser!.avatarEmoji!=null) await p.setString(_kAE,currentUser!.avatarEmoji!); else await p.remove(_kAE);
    if (currentUser!.avatarBytes!=null) await p.setString(_kAB,base64Encode(currentUser!.avatarBytes!)); else await p.remove(_kAB);
    await p.setBool(_kDM,appDarkMode);
  }

  static Future<void> clear() async { final p=await SharedPreferences.getInstance(); await p.clear(); }

  static Future<bool> checkDailyBonus() async {
    if (currentUser==null) return false;
    if (currentUser!.monthlyCoins>=100) return false;
    final today=_todayKey();
    if (!currentUser!.coinLog.containsKey(today)) {
      currentUser!.coinLog[today]=1; currentUser!.coins++;
      await save(); return true;
    }
    return false;
  }

  static String _todayKey() { final n=DateTime.now();
    return '${n.year}-${n.month.toString().padLeft(2,'0')}-${n.day.toString().padLeft(2,'0')}'; }

  static Future<List<String>> getSearchHistory() async {
    final p=await SharedPreferences.getInstance();
    return p.getStringList(_kSH)??[];
  }

  static Future<void> addSearch(String q) async {
    if(q.trim().isEmpty) return;
    final p=await SharedPreferences.getInstance();
    final h=p.getStringList(_kSH)??[];
    h.remove(q); h.insert(0,q);
    if(h.length>20) h.removeLast();
    await p.setStringList(_kSH,h);
  }

  static Future<void> clearSearchHistory() async {
    final p=await SharedPreferences.getInstance(); await p.remove(_kSH); }
}

// ═══════════════════════════════════════════════════════════════════════════
// OVERPASS API
// ═══════════════════════════════════════════════════════════════════════════
Future<List<OrgPin>> fetchOverpassOrgs(LatLng center, double radiusKm) async {
  final r=(radiusKm*1000).toInt();
  final lat=center.latitude, lng=center.longitude;
  final query='''[out:json][timeout:25];(
  node["amenity"="veterinary"](around:$r,$lat,$lng);
  way["amenity"="veterinary"](around:$r,$lat,$lng);
  node["amenity"="animal_shelter"](around:$r,$lat,$lng);
  way["amenity"="animal_shelter"](around:$r,$lat,$lng);
  node["shop"="pet"](around:$r,$lat,$lng);
  node["amenity"="animal_boarding"](around:$r,$lat,$lng);
);out center;''';
  try {
    final resp = await http.post(Uri.parse('https://overpass-api.de/api/interpreter'),
      body: query, headers: {'Content-Type':'application/x-www-form-urlencoded'})
      .timeout(const Duration(seconds:30));
    if (resp.statusCode!=200) return [];
    final data = jsonDecode(resp.body) as Map;
    final elements = data['elements'] as List;
    final dist = const Distance();
    final List<OrgPin> pins=[];
    for (final el in elements) {
      final tags=(el['tags'] as Map?)??{};
      final name=tags['name']??tags['operator']??'Unnamed Organization';
      double? elat,elng;
      if (el['type']=='node') { elat=(el['lat'] as num?)?.toDouble(); elng=(el['lon'] as num?)?.toDouble(); }
      else if (el['center']!=null) { elat=(el['center']['lat'] as num?)?.toDouble(); elng=(el['center']['lon'] as num?)?.toDouble(); }
      if (elat==null||elng==null) continue;
      final pos=LatLng(elat,elng);
      final km=dist.as(LengthUnit.Kilometer,center,pos);
      final amenity=tags['amenity']??''; final shop=tags['shop']??'';
      OrgType t=OrgType.other;
      if (amenity=='veterinary') t=OrgType.vet;
      else if (amenity=='animal_shelter') t=OrgType.shelter;
      else if (shop=='pet') t=OrgType.clinic;
      else if (amenity=='animal_boarding') t=OrgType.welfare;
      pins.add(OrgPin(name:name.toString(),type:t,position:pos,
        phone:tags['phone']?.toString(),website:tags['website']?.toString(),distanceKm:km));
    }
    pins.sort((a,b)=>a.distanceKm.compareTo(b.distanceKm));
    return pins;
  } catch(_) { return []; }
}

Future<List<OrgPin>> searchNominatim(String query, LatLng? center) async {
  final q=Uri.encodeComponent('$query animal shelter OR veterinary OR pet');
  final url='https://nominatim.openstreetmap.org/search?q=$q&format=json&limit=10&addressdetails=1';
  try {
    final resp=await http.get(Uri.parse(url),
      headers:{'User-Agent':'AL-AGAP/1.0 alagap.philippines@gmail.com'})
      .timeout(const Duration(seconds:15));
    if (resp.statusCode!=200) return [];
    final data=jsonDecode(resp.body) as List;
    final dist=const Distance();
    return data.map((el){
      final lat=double.tryParse(el['lat'].toString())??0;
      final lng=double.tryParse(el['lon'].toString())??0;
      final pos=LatLng(lat,lng);
      final km=center!=null?dist.as(LengthUnit.Kilometer,center,pos):0.0;
      return OrgPin(name:(el['display_name']??'').toString().split(',').first,
        type:OrgType.other,position:pos,distanceKm:km);
    }).toList();
  } catch(_) { return []; }
}

