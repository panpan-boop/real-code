// ─────────────────────────────────────────────────────────────────────────────
// IMAGE ARG
// ─────────────────────────────────────────────────────────────────────────────
class ImageArg {
  final File?      file;
  final Uint8List? bytes;
  const ImageArg({this.file, this.bytes});
  bool get hasImage => file != null || bytes != null;
}

Widget buildImage(ImageArg? arg, {BoxFit fit = BoxFit.cover}) {
  if (arg == null || !arg.hasImage) return const SizedBox();
  if (arg.bytes != null) return Image.memory(arg.bytes!, fit: fit);
  return Image.file(arg.file!, fit: fit);
}

